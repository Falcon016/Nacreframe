# systemd unit for running the dashboard without Docker.
#   sudo cp deploy/nexusharness.service /etc/systemd/system/ && sudo systemctl enable --now nexusharness
# Edit User, WorkingDirectory, --root and the token file to match your machine.
[Unit]
Description=NexusHarness dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=nexus
WorkingDirectory=/opt/nexusharness
# Create the token once:  openssl rand -base64 24 | sudo tee /etc/nexusharness/token && sudo chmod 600 /etc/nexusharness/token
EnvironmentFile=/etc/nexusharness/env
ExecStart=/usr/bin/node dist/cli.js serve --host 127.0.0.1 --port 7437 --root /srv/projects
Restart=on-failure
RestartSec=3

# Hardening: the agent runs commands as this user, so keep the unit itself tight.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/projects /var/lib/nexusharness
Environment=NEXUS_HOME=/var/lib/nexusharness

[Install]
WantedBy=multi-user.target
